{
  "lookup-ip-context": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "ip": {
        "anyOf": [
          {
            "type": "string",
            "format": "ipv4",
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
          },
          {
            "type": "string",
            "format": "ipv6",
            "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
          }
        ],
        "description": "IP address to look up (IPv4 or IPv6)"
      }
    },
    "required": [
      "ip"
    ]
  },
  "gnql-query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "GNQL query string"
      },
      "size": {
        "description": "Results per page (default: 25, max: 10000)",
        "default": 25,
        "type": "number",
        "minimum": 1,
        "maximum": 10000
      },
      "scroll": {
        "description": "Pagination scroll token from a previous response",
        "type": "string"
      }
    },
    "required": [
      "query"
    ]
  },
  "gnql-timeseries": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "GNQL query string"
      },
      "start_time": {
        "description": "Start of time range (ISO 8601 format, e.g. 2025-01-15T00:00:00Z)",
        "type": "string"
      },
      "end_time": {
        "description": "End of time range (ISO 8601 format)",
        "type": "string"
      },
      "size": {
        "description": "Results per hourly bucket (default: 25)",
        "default": 25,
        "type": "number",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "required": [
      "query"
    ]
  }
}
