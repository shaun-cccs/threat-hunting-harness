          "required": [
            "reviewer",
            "assessment",
            "rationale"
          ],
          "title": "Review",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "required": [
        "case_id",
        "finding_id",
        "review"
