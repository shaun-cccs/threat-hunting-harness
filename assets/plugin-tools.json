  {
    "name": "analyst_decide",
    "description": "Record an analyst's explicit chat decision; quote their instruction in confirmation.\n\n        Only the coordinator may call this after the user has accepted, rejected, or requested\n        more work on the finding. Investigator/reviewer judgments are not analyst decisions.\n        The confirmation is an audit record, not authentication of a human identity.\n        ",
    "inputSchema": {
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "confirmation": {
          "title": "Confirmation",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "finding_id",
        "decision",
        "rationale",
        "confirmation"
      ],
      "title": "analyst_decideArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "analyst_decideDictOutput",
      "type": "object"
    }
  },
