  {
    "name": "finding_propose",
    "description": "",
    "inputSchema": {
      "$defs": {
        "Claim": {
          "additionalProperties": false,
          "properties": {
            "candidate": {
              "title": "Candidate",
              "type": "string"
            },
            "kind": {
              "enum": [
                "relatedness",
                "historical_association",
                "current_malicious_use",
                "attribution"
              ],
              "title": "Kind",
              "type": "string"
            },
            "statement": {
              "minLength": 1,
              "title": "Statement",
              "type": "string"
            },
            "evidence_ids": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Evidence Ids",
              "type": "array"
            },
            "alternative_explanations": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Alternative Explanations",
              "type": "array"
            },
            "freshness_start": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Freshness Start"
            },
            "freshness_end": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Freshness End"
            },
            "attribution_basis": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Attribution Basis"
            },
            "hypothesis": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Hypothesis"
            }
          },
          "required": [
            "candidate",
            "kind",
            "statement",
            "evidence_ids",
            "alternative_explanations"
          ],
          "title": "Claim",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "case_id",
        "claim"
      ],
      "title": "finding_proposeArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "finding_proposeDictOutput",
      "type": "object"
    }
  },
  {
