[
  {
    "name": "case_create",
    "description": "Create a case without contacting any provider.",
    "inputSchema": {
      "$defs": {
        "CaseSpec": {
          "additionalProperties": false,
          "properties": {
            "hypothesis": {
              "minLength": 1,
              "title": "Hypothesis",
              "type": "string"
            },
            "seeds": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Seeds",
              "type": "array"
            },
            "start": {
              "format": "date",
              "title": "Start",
              "type": "string"
            },
            "end": {
              "format": "date",
              "title": "End",
              "type": "string"
            },
            "limits": {
              "additionalProperties": {
                "type": "integer"
              },
              "title": "Limits",
              "type": "object"
            }
          },
          "required": [
            "hypothesis",
            "seeds",
            "start",
            "end"
          ],
          "title": "CaseSpec",
          "type": "object"
        }
      },
      "properties": {
        "spec": {
          "$ref": "#/$defs/CaseSpec"
        }
      },
      "required": [
        "spec"
      ],
      "title": "case_createArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "case_createDictOutput",
      "type": "object"
    }
  },
  {
    "name": "case_read",
    "description": "Read the retained case and recorded hunt status.\n\n        The default view omits retained provider payloads so a grown case stays readable. Pass\n        section with offset to page one list, or view=\"full\" for whole records under a size\n        ceiling. Reading evidence raw payloads requires view=\"full\".\n        ",
    "inputSchema": {
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "view": {
          "default": "summary",
          "title": "View",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "case_id"
      ],
      "title": "case_readArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "case_readDictOutput",
      "type": "object"
    }
  },
  {
    "name": "playbooks",
    "description": "Read shared playbooks before selecting an investigation strategy.",
    "inputSchema": {
      "properties": {},
      "title": "playbooksArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "playbooksDictOutput",
      "type": "object"
    }
  },
  {
    "name": "provider_operations",
    "description": "List configured providers and their supported query operations.",
    "inputSchema": {
      "properties": {},
      "title": "provider_operationsArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "provider_operationsDictOutput",
      "type": "object"
    }
  },
  {
    "name": "query_submit",
    "description": "Submit a provider query within shared case limits and return a job to poll with job_read.\n\n        Matching submissions reuse retained jobs unless refresh is explicitly requested.\n        Pagination requires a separate submission; results are retained before narrowing.\n        ",
    "inputSchema": {
      "$defs": {
        "QuerySpec": {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "title": "Provider",
              "type": "string"
            },
            "operation": {
              "title": "Operation",
              "type": "string"
            },
            "arguments": {
              "additionalProperties": true,
              "title": "Arguments",
              "type": "object"
            },
            "pivot_from": {
              "title": "Pivot From",
              "type": "string"
            },
            "purpose": {
              "minLength": 1,
              "title": "Purpose",
              "type": "string"
            },
            "refresh": {
              "default": false,
              "title": "Refresh",
              "type": "boolean"
            },
            "continuation_of": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Continuation Of"
            }
          },
          "required": [
            "provider",
            "operation",
            "arguments",
            "pivot_from",
            "purpose"
          ],
          "title": "QuerySpec",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/QuerySpec"
        }
      },
      "required": [
        "case_id",
        "query"
      ],
      "title": "query_submitArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "query_submitDictOutput",
      "type": "object"
    }
  },
  {
    "name": "job_read",
    "description": "Read a submitted query job's status, usage, and retained result metadata.",
    "inputSchema": {
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "job_id"
      ],
      "title": "job_readArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "job_readDictOutput",
      "type": "object"
    }
  },
  {
    "name": "candidate_select",
    "description": "Select a retained candidate for expansion using evidence aligned with campaign dates.",
    "inputSchema": {
      "$defs": {
        "Expansion": {
          "additionalProperties": false,
          "properties": {
            "candidate": {
              "title": "Candidate",
              "type": "string"
            },
            "evidence_ids": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Evidence Ids",
              "type": "array"
            },
            "hypothesis": {
              "minLength": 1,
              "title": "Hypothesis",
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            },
            "relationship": {
              "title": "Relationship",
              "type": "string"
            },
            "distinctive": {
              "default": false,
              "title": "Distinctive",
              "type": "boolean"
            }
          },
          "required": [
            "candidate",
            "evidence_ids",
            "hypothesis",
            "rationale",
            "relationship"
          ],
          "title": "Expansion",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/Expansion"
        }
      },
      "required": [
        "case_id",
        "selection"
      ],
      "title": "candidate_selectArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "candidate_selectDictOutput",
      "type": "object"
    }
  },
  {
    "name": "candidate_defer",
    "description": "Defer a candidate with its class, that class's evidence, and what would reopen it.\n\n        A deferral without cited evidence is recorded as `uninspected` and reported as an open\n        lead at settle: narrowing an unread candidate postpones the question, it does not answer it.\n        ",
    "inputSchema": {
      "$defs": {
        "Deferral": {
          "additionalProperties": false,
          "description": "Narrowing carries the same burden as expansion: a class, its basis, and a way back.",
          "properties": {
            "candidate": {
              "title": "Candidate",
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            },
            "basis": {
              "default": "uninspected",
              "enum": [
                "prevalence",
                "out_of_scope",
                "uninspected"
              ],
              "title": "Basis",
              "type": "string"
            },
            "basis_evidence_ids": {
              "items": {
                "type": "string"
              },
              "title": "Basis Evidence Ids",
              "type": "array"
            },
            "reopen_if": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reopen If"
            }
          },
          "required": [
            "candidate",
            "rationale"
          ],
          "title": "Deferral",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "deferral": {
          "$ref": "#/$defs/Deferral"
        }
      },
      "required": [
        "case_id",
        "deferral"
      ],
      "title": "candidate_deferArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "candidate_deferDictOutput",
      "type": "object"
    }
  },
  {
    "name": "coverage_record",
    "description": "Record what a source could and could not answer, without asserting a finding.\n\n        Non-detection belongs here. A provider that held no record of the subject supplies no\n        evidence about it, so this states which providers, fields and dates were actually\n        covered instead of letting silence read as a negative observation.\n        ",
    "inputSchema": {
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "looked_at": {
          "items": {
            "type": "string"
          },
          "title": "Looked At",
          "type": "array"
        },
        "not_covered": {
          "items": {
            "type": "string"
          },
          "title": "Not Covered",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "subject",
        "question",
        "looked_at",
        "not_covered"
      ],
      "title": "coverage_recordArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "coverage_recordDictOutput",
      "type": "object"
    }
  },
  {
    "name": "finding_propose",
    "description": "Propose a finding linked to retained evidence for subsequent review.",
    "inputSchema": {
      "$defs": {
        "Claim": {
          "additionalProperties": false,
          "properties": {
            "candidate": {
              "title": "Candidate",
              "type": "string"
            },
            "kind": {
              "enum": [
                "relatedness",
                "historical_association",
                "current_malicious_use",
                "attribution"
              ],
              "title": "Kind",
              "type": "string"
            },
            "statement": {
              "minLength": 1,
              "title": "Statement",
              "type": "string"
            },
            "evidence_ids": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Evidence Ids",
              "type": "array"
            },
            "alternative_explanations": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Alternative Explanations",
              "type": "array"
            },
            "freshness_start": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Freshness Start"
            },
            "freshness_end": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Freshness End"
            },
            "attribution_basis": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Attribution Basis"
            },
            "hypothesis": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Hypothesis"
            },
            "coverage": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Coverage"
            }
          },
          "required": [
            "candidate",
            "kind",
            "statement",
            "evidence_ids",
            "alternative_explanations"
          ],
          "title": "Claim",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "case_id",
        "claim"
      ],
      "title": "finding_proposeArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "finding_proposeDictOutput",
      "type": "object"
    }
  },
  {
    "name": "finding_review",
    "description": "Record an evidence review of a finding before the analyst's decision.",
    "inputSchema": {
      "$defs": {
        "Review": {
          "additionalProperties": false,
          "properties": {
            "reviewer": {
              "minLength": 1,
              "title": "Reviewer",
              "type": "string"
            },
            "assessment": {
              "enum": [
                "supported",
                "challenged",
                "insufficient"
              ],
              "title": "Assessment",
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            },
            "flags": {
              "items": {
                "enum": [
                  "shared_infrastructure",
                  "stale_evidence",
                  "conflicting_observations",
                  "reassignment",
                  "copied_sources",
                  "missing_dates",
                  "unsupported_attribution"
                ],
                "type": "string"
              },
              "title": "Flags",
              "type": "array"
            },
            "alternative_explanations": {
              "items": {
                "type": "string"
              },
              "title": "Alternative Explanations",
              "type": "array"
            }
          },
          "required": [
            "reviewer",
            "assessment",
            "rationale"
          ],
          "title": "Review",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "required": [
        "case_id",
        "finding_id",
        "review"
      ],
      "title": "finding_reviewArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "finding_reviewDictOutput",
      "type": "object"
    }
  },
  {
